# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要把真实 key 提交进仓库。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
VLM_FALLBACK_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_TIMEOUT_SECONDS=120

# 部分第三方端点不支持 response_format={"type":"json_object"}，遇到报错就设 false
LLM_JSON_MODE=false

# 置 true 则完全不走网络，全部用本地 Mock Provider（断网演示保险）
FORCE_MOCK_LLM=false

# ---- 备用 provider（另一个厂商，抗单点故障）----
# 主厂商整体挂掉时，同一家的备选模型会一起哑，所以要换厂商。
# 它在两处生效：
#   1. 图片识别链的第二环（主 → **本模型** → 8B 备选）。
#      DeepSeek 识别质量其实最高（只是慢），所以排在 8B 之前，优先保证质量。
#   2. 二次求解校验（与识别模型异构，独立性更好）
# 注意 deepseek-flash 是**推理模型**，思考 token 也算 max_tokens，要留余量。
BACKUP_LLM_BASE_URL=https://api.deepseek.com/v1
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=deepseek-flash
# 用备用模型做二次求解校验。设 false 则用 LLM_MODEL。
VERIFY_WITH_BACKUP_MODEL=true

# LLM 调用失败时是否降级到 Mock（Demo 可靠性优先）
LLM_FALLBACK_TO_MOCK=true

DATABASE_PATH=data/haoxue.db
